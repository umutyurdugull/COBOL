@{
    ViewData["Title"] = "Dashboard";
}

<div class="dashboard-container">
    <!-- Datasets Tab (Active by Default) -->
    <div id="tab-datasets" class="tab-panel active">
        <div class="row">
            <!-- Left Side: Explorer -->
            <div class="col-md-5">
                <div class="glass-card mb-4">
                    <div class="card-header-accent">
                        <i class="fa-solid fa-folder-tree text-neon"></i> Dataset Search &amp; Explorer
                    </div>
                    <div class="card-body-content">
                        <div class="search-box mb-3">
                            <label for="ds-level-input" class="form-label-custom">Dataset Level (Prefix)</label>
                            <div class="input-group">
                                <span class="input-group-text-custom"><i class="fa-solid fa-magnifying-glass"></i></span>
                                <input type="text" id="ds-level-input" class="form-control-custom" placeholder="e.g. Z88116" value="Z88116">
                                <button class="btn-neon" id="btn-search-datasets">Search</button>
                            </div>
                        </div>

                        <div class="explorer-list-container">
                            <div class="empty-state" id="datasets-empty-state">
                                <i class="fa-solid fa-hourglass-empty"></i>
                                <p>Search a dataset level prefix to explore files.</p>
                            </div>
                            <div id="datasets-list" class="list-group-custom d-none">
                                <!-- Populated dynamically -->
                            </div>
                        </div>
                    </div>
                </div>

                <div class="glass-card d-none" id="members-card">
                    <div class="card-header-accent">
                        <i class="fa-solid fa-list text-neon"></i> PDS Members (Files)
                    </div>
                    <div class="card-body-content">
                        <h6 class="selected-dataset-title text-muted mb-3" id="selected-ds-label">Z88116.JCL</h6>
                        <div class="explorer-list-container" style="max-height: 250px;">
                            <div id="members-list" class="list-group-custom">
                                <!-- Populated dynamically -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side: Editor -->
            <div class="col-md-7">
                <div class="glass-card h-100 flex-column d-flex">
                    <div class="card-header-accent d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fa-solid fa-code text-neon"></i> Mainframe File Editor
                        </div>
                        <span class="editor-file-path" id="editor-file-path">No File Open</span>
                    </div>
                    <div class="card-body-content flex-grow-1 d-flex flex-column p-0">
                        <div class="editor-toolbar p-2 border-bottom border-secondary d-flex justify-content-between align-items-center">
                            <span class="text-muted small" id="editor-status">Ready</span>
                            <button class="btn-neon btn-sm d-none" id="btn-save-content">
                                <i class="fa-solid fa-floppy-disk"></i> Save Content
                            </button>
                        </div>
                        <textarea id="editor-textarea" class="editor-code" readonly placeholder="Select a dataset or member to view and edit its content..."></textarea>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- JCL Submitter Tab -->
    <div id="tab-jcl-runner" class="tab-panel">
        <div class="row">
            <div class="col-md-8">
                <div class="glass-card">
                    <div class="card-header-accent d-flex justify-content-between align-items-center">
                        <div>
                            <i class="fa-solid fa-file-code text-neon"></i> Edit JCL Payload
                        </div>
                        <button class="btn-neon" id="btn-submit-jcl">
                            <i class="fa-solid fa-paper-plane"></i> Submit Job
                        </button>
                    </div>
                    <div class="card-body-content p-0">
                        <textarea id="jcl-editor-textarea" class="jcl-code-editor" placeholder="Write JCL card images here...">//Z88116J JOB 1,NOTIFY=Z88116
//COBRUN   EXEC IGYWCLG,SRC=DYSALE
//GO.SALES    DD DSNAME=Z88116.SALES.DAT,DISP=SHR
//GO.VALIDSAL DD DSNAME=Z88116.VALID.DAT,DISP=SHR
//GO.ERRORS   DD DSNAME=Z88116.ERROR.LOG,DISP=SHR
//GO.REPOUT   DD DSNAME=Z88116.REPORT.TXT,DISP=SHR
//GO.SORTWK01 DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))
//GO.SORTWK02 DD UNIT=SYSALLDA,SPACE=(CYL,(1,1))</textarea>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="glass-card h-100">
                    <div class="card-header-accent">
                        <i class="fa-solid fa-circle-info text-neon"></i> JCL Information
                    </div>
                    <div class="card-body-content">
                        <p class="small text-muted">Submit JCL scripts directly to the mainframe Jes spool. The portal will automatically track compilation status, return codes, and retrieve execution logs.</p>
                        <div class="info-metric-container">
                            <div class="metric-card">
                                <span class="metric-label">Max Line Length</span>
                                <span class="metric-value text-neon">80 Chars</span>
                            </div>
                            <div class="metric-card">
                                <span class="metric-label">Spool retention</span>
                                <span class="metric-value text-neon">24 Hours</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SQL Console Tab -->
    <div id="tab-sql-console" class="tab-panel">
        <div class="glass-card mb-4">
            <div class="card-header-accent">
                <i class="fa-solid fa-terminal text-neon"></i> Dynamic SQL Execution Panel
            </div>
            <div class="card-body-content">
                <div class="row mb-3">
                    <div class="col-md-4">
                        <label class="form-label-custom">Db2 Utility Program</label>
                        <select class="form-select-custom" id="sql-utility-select">
                            <option value="DSNTEP2" selected>DSNTEP2 (SELECT &amp; non-SELECT) [Recommended]</option>
                            <option value="DSNTEP4">DSNTEP4 (Multi-Row Fetch SELECT)</option>
                            <option value="DSNTIAD">DSNTIAD (non-SELECT Statements only)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label-custom">Subsystem / Plan Name</label>
                        <div class="input-group">
                            <span class="input-group-text-custom">PLAN</span>
                            <input type="text" class="form-control-custom" id="sql-plan-input" value="DSNTEPD1">
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button class="btn-neon w-100" id="btn-execute-sql">
                            <i class="fa-solid fa-bolt"></i> Execute Query
                        </button>
                    </div>
                </div>

                <div class="mb-2">
                    <label for="sql-textarea" class="form-label-custom">SQL Statement</label>
                    <textarea class="sql-code-editor" id="sql-textarea" placeholder="SELECT * FROM IBMUSER.EMP FETCH FIRST 5 ROWS ONLY;"></textarea>
                </div>
            </div>
        </div>

        <div class="glass-card d-none" id="sql-results-card">
            <div class="card-header-accent d-flex justify-content-between align-items-center">
                <div>
                    <i class="fa-solid fa-table text-neon"></i> Execution Output
                </div>
                <div class="results-toolbar">
                    <button class="btn-tab-sub active" data-subtab="subtab-sql-grid">Grid View</button>
                    <button class="btn-tab-sub" data-subtab="subtab-sql-sysprint">Raw SYSPRINT</button>
                    <button class="btn-tab-sub" data-subtab="subtab-sql-systsprt">TSO Spool</button>
                </div>
            </div>
            <div class="card-body-content p-0">
                <!-- Grid View -->
                <div id="subtab-sql-grid" class="subtab-panel active">
                    <div class="table-responsive p-3" style="max-height: 400px;">
                        <table class="table table-custom m-0" id="sql-grid-table">
                            <thead id="sql-grid-thead">
                                <!-- Dynamic Headers -->
                            </thead>
                            <tbody id="sql-grid-tbody">
                                <!-- Dynamic Rows -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Raw SYSPRINT Monospace -->
                <div id="subtab-sql-sysprint" class="subtab-panel">
                    <pre class="spool-viewer" id="sql-sysprint-text">Fetching SYSPRINT...</pre>
                </div>

                <!-- Raw SYSTSPRT Monospace -->
                <div id="subtab-sql-systsprt" class="subtab-panel">
                    <pre class="spool-viewer" id="sql-systsprt-text">Fetching SYSTSPRT...</pre>
                </div>
            </div>
        </div>
    </div>

    <!-- Jobs Queue Tab -->
    <div id="tab-job-queue" class="tab-panel">
        <div class="glass-card">
            <div class="card-header-accent d-flex justify-content-between align-items-center">
                <div>
                    <i class="fa-solid fa-list-check text-neon"></i> Submitted Jobs Tracker
                </div>
                <button class="btn-neon btn-sm" id="btn-refresh-jobs">
                    <i class="fa-solid fa-rotate"></i> Refresh List
                </button>
            </div>
            <div class="card-body-content p-0">
                <div class="table-responsive">
                    <table class="table table-custom m-0">
                        <thead>
                            <tr>
                                <th>Job ID</th>
                                <th>Job Name</th>
                                <th>Status</th>
                                <th>Return Code</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="jobs-table-body">
                            <!-- Populated dynamically via JS session memory -->
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">No jobs submitted in this session.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Settings Tab -->
    <div id="tab-settings" class="tab-panel">
        <div class="row">
            <div class="col-md-6">
                <div class="glass-card">
                    <div class="card-header-accent">
                        <i class="fa-solid fa-gear text-neon"></i> Connection Configurations
                    </div>
                    <div class="card-body-content">
                        <div class="mb-3">
                            <label for="settings-url" class="form-label-custom">z/OSMF Base URL</label>
                            <input type="text" class="form-control-custom" id="settings-url" value="https://204.90.115.200:10443">
                        </div>
                        <div class="mb-3">
                            <label for="settings-username" class="form-label-custom">RACF Username</label>
                            <input type="text" class="form-control-custom" id="settings-username" value="Z88116">
                        </div>
                        <div class="mb-3">
                            <label for="settings-password" class="form-label-custom">RACF Password</label>
                            <input type="password" class="form-control-custom" id="settings-password" value="GRB53ONI">
                        </div>
                        <button class="btn-neon w-100" id="btn-save-settings">
                            <i class="fa-solid fa-circle-check"></i> Apply Settings
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="glass-card">
                    <div class="card-header-accent">
                        <i class="fa-solid fa-shield-halved text-neon"></i> Security &amp; Credentials
                    </div>
                    <div class="card-body-content">
                        <p class="small text-muted">All connection settings are stored locally in the server's session context. Certifications for insecure connections are bypassed in dev modes.</p>
                        <div class="alert alert-warning-custom">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <div>
                                <strong>RACF Credentials:</strong> Keep your mainframe password secure. Do not share or push config files with production credentials to public version controls.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Spool Modal -->
<div class="modal fade modal-custom" id="spoolModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content-custom">
            <div class="modal-header-custom">
                <h5 class="modal-title" id="spoolModalTitle">Job Output Spool</h5>
                <button type="button" class="btn-close-custom" data-bs-dismiss="modal" aria-label="Close">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div class="modal-body p-0">
                <div class="modal-tabs">
                    <button class="btn-modal-tab active" data-spooltab="modal-sysprint">SYSPRINT</button>
                    <button class="btn-modal-tab" data-spooltab="modal-systsprt">SYSTSPRT</button>
                </div>
                <div class="modal-tab-content">
                    <div id="modal-sysprint" class="modal-spool-panel active">
                        <pre id="modal-sysprint-text">Loading...</pre>
                    </div>
                    <div id="modal-systsprt" class="modal-spool-panel">
                        <pre id="modal-systsprt-text">Loading...</pre>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Global Loading Overlay -->
<div class="loading-overlay d-none" id="global-loader">
    <div class="spinner-container">
        <div class="spinner-neon"></div>
        <div class="loader-message" id="loader-message">Processing request...</div>
    </div>
</div>
